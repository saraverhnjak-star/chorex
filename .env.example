# Non-secret configuration. Copy into each app's .env.local (Expo reads per app).
# iOS Simulator: 127.0.0.1; Android Emulator: 10.0.2.2.
# Physical devices: development machine's private LAN IPv4 address.
EXPO_PUBLIC_FIREBASE_MODE=emulator
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
EXPO_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# Optional until EAS projects exist. Configure each app with its own real project ID.
EXPO_PUBLIC_PARENT_EAS_PROJECT_ID=
EXPO_PUBLIC_CHILD_EAS_PROJECT_ID=

# App Check debug provider is selected only for __DEV__ emulator builds.
# No debug secret belongs in this file or any EXPO_PUBLIC_* variable.
# Production release builds use a separate environment: unset ALL emulator values,
# set EXPO_PUBLIC_FIREBASE_MODE=production and EXPO_PUBLIC_FIREBASE_PROJECT_ID
# to the actual separate Firebase project. Native files must match that project.
# Supply build-time file paths for the app being built (not public JS config):
# CHOREX_PARENT_GOOGLE_SERVICES_IOS=/private/path/GoogleService-Info.plist
# CHOREX_PARENT_GOOGLE_SERVICES_ANDROID=/private/path/google-services.json
# CHOREX_CHILD_GOOGLE_SERVICES_IOS=/private/path/GoogleService-Info.plist
# CHOREX_CHILD_GOOGLE_SERVICES_ANDROID=/private/path/google-services.json
# Configure native identities/provisioning and providers before release validation.
