rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/deletionFences/$(request.auth.uid));
    }

    function isActiveFamilyMember(familyId) {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/familyDeletionFences/$(familyId))
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function isActiveParent(familyId) {
      return isActiveFamilyMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'PARENT';
    }

    match /deletionFences/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;

      match /preferences/{preferenceId} {
        function isPreferenceOwner() {
          return isSignedIn() && request.auth.uid == uid && preferenceId == 'reminders';
        }
        function validReminders() {
          let role = get(/databases/$(database)/documents/users/$(uid)).data.accountType;
          return (role == 'CHILD'
              && request.resource.data.keys().hasOnly(['deadlineRemindersEnabled'])
              && request.resource.data.keys().hasAll(['deadlineRemindersEnabled'])
              && request.resource.data.deadlineRemindersEnabled is bool)
            || (role == 'PARENT'
              && request.resource.data.keys().hasOnly(['pendingRewardRemindersEnabled'])
              && request.resource.data.keys().hasAll(['pendingRewardRemindersEnabled'])
              && request.resource.data.pendingRewardRemindersEnabled is bool);
        }
        allow get: if isPreferenceOwner();
        allow create, update: if isPreferenceOwner() && validReminders();
        allow list, delete: if false;
      }

      match /devices/{deviceId} {
        function isDeviceOwner() {
          return isSignedIn() && request.auth.uid == uid
            && exists(/databases/$(database)/documents/users/$(uid));
        }

        function hasValidDeviceShape() {
          return request.resource.data.keys().hasOnly([
              'platform',
              'appVariant',
              'appVersion',
              'expoPushToken',
              'pushEnabled',
              'createdAt',
              'lastSeenAt'
            ])
            && request.resource.data.keys().hasAll([
              'platform',
              'appVariant',
              'appVersion',
              'expoPushToken',
              'pushEnabled',
              'createdAt',
              'lastSeenAt'
            ])
            && request.resource.data.platform in ['ios', 'android']
            && request.resource.data.appVariant in ['PARENT', 'CHILD']
            && request.resource.data.appVersion is string
            && request.resource.data.appVersion.size() > 0
            && request.resource.data.appVersion.size() <= 64
            && request.resource.data.expoPushToken is string
            && request.resource.data.expoPushToken.size() > 0
            && request.resource.data.expoPushToken.size() <= 512
            && request.resource.data.pushEnabled == true
            && request.resource.data.lastSeenAt == request.time;
        }

        allow get, list: if isDeviceOwner();
        allow create: if isDeviceOwner()
          && deviceId.size() > 0
          && deviceId.size() <= 128
          && hasValidDeviceShape()
          && request.resource.data.createdAt == request.time;
        allow update: if isDeviceOwner()
          && hasValidDeviceShape()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isDeviceOwner();
      }
    }

    match /families/{familyId} {
      allow get: if isActiveFamilyMember(familyId);
      allow list, write: if false;

      match /members/{uid} {
        allow get, list: if isActiveFamilyMember(familyId);
        allow write: if false;
      }
    }

    match /offers/{offerId} {
      function canReadOffer() {
        return isSignedIn()
          && ((resource.data.status == 'DRAFT'
            && resource.data.parentUid == request.auth.uid
            && isActiveParent(resource.data.familyId))
          || (request.auth.uid in resource.data.participantUids
            && isActiveFamilyMember(resource.data.familyId)
            && resource.data.status in [
              'AWAITING_CHILD',
              'AWAITING_PARENT',
              'ACCEPTED',
              'REJECTED',
              'CANCELLED',
              'EXPIRED'
            ]));
      }

      allow get: if canReadOffer();
      allow list: if canReadOffer()
        && (resource.data.status == 'AWAITING_CHILD'
          || (resource.data.status == 'AWAITING_PARENT'
            && resource.data.parentUid == request.auth.uid
            && isActiveParent(resource.data.familyId)));
      allow write: if false;

      match /revisions/{revisionId} {
        function offer() {
          return get(/databases/$(database)/documents/offers/$(offerId));
        }

        function canReadOfferRevision() {
          return isSignedIn()
            && ((offer().data.status == 'DRAFT'
              && offer().data.parentUid == request.auth.uid
              && isActiveParent(offer().data.familyId))
            || (request.auth.uid in offer().data.participantUids
              && isActiveFamilyMember(offer().data.familyId)
              && offer().data.status in [
                'AWAITING_CHILD',
                'AWAITING_PARENT',
                'ACCEPTED',
                'REJECTED',
                'CANCELLED',
                'EXPIRED'
              ]));
        }

        allow get: if canReadOfferRevision();
        allow list, write: if false;
      }
    }

    match /contracts/{contractId} {
      function canReadContract() {
        return isSignedIn()
          && request.auth.uid in resource.data.participantUids
          && isActiveFamilyMember(resource.data.familyId);
      }

      allow get, list: if canReadContract();
      allow write: if false;

      match /reviews/{reviewId} {
        function contract() {
          return get(/databases/$(database)/documents/contracts/$(contractId));
        }
        function canReadReview() {
          return isSignedIn()
            && request.auth.uid in contract().data.participantUids
            && isActiveFamilyMember(contract().data.familyId)
            && resource.data.familyId == contract().data.familyId
            && resource.data.contractId == contractId;
        }
        allow get, list: if canReadReview();
        allow write: if false;
      }

      match /tasks/{taskId} {
        function contract() {
          return get(/databases/$(database)/documents/contracts/$(contractId));
        }

        function canReadContractTask() {
          return isSignedIn()
            && request.auth.uid in contract().data.participantUids
            && isActiveFamilyMember(contract().data.familyId)
            && resource.data.contractId == contractId
            && resource.data.familyId == contract().data.familyId;
        }

        allow get: if canReadContractTask();
        allow list: if isSignedIn()
          && request.auth.uid in contract().data.participantUids
          && isActiveFamilyMember(contract().data.familyId);
        allow write: if false;
      }
    }

    match /rewards/{rewardId} {
      function canReadReward() {
        return isSignedIn() && isActiveFamilyMember(resource.data.familyId)
          && (request.auth.uid == resource.data.parentUid || request.auth.uid == resource.data.childUid);
      }
      allow get, list: if canReadReward();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
